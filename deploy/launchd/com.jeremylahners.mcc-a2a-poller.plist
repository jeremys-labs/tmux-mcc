<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jeremylahners.mcc-a2a-poller</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/Repo-Drive/src/mcc-tmux/scripts/start-a2a-poller.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Volumes/Repo-Drive/src/mcc-tmux</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/jeremylahners</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>AGENT_MAIL_DIR</key>
    <string>/Volumes/Repo-Drive/agents/SHARED/agent-mail</string>
    <key>A2A_POLLER_LOG_PATH</key>
    <string>/Volumes/Repo-Drive/src/mcc-tmux/logs/a2a-poller.log</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Volumes/Repo-Drive/src/mcc-tmux/logs/a2a-poller.log</string>

  <key>StandardErrorPath</key>
  <string>/Volumes/Repo-Drive/src/mcc-tmux/logs/a2a-poller.err.log</string>
</dict>
</plist>
