{
  "name": "mcc-tmux",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper 2>/dev/null || true",
    "dev": "concurrently \"npm run dev --workspace=packages/server\" \"npm run dev --workspace=packages/client\"",
    "build": "npm run build --workspace=packages/client && npm run build --workspace=packages/server",
    "test": "npm run test --workspace=@mcc-tmux/server && npm run test --workspace=@mcc-tmux/client",
    "test:server": "npm run test --workspace=@mcc-tmux/server",
    "test:client": "npm run test --workspace=@mcc-tmux/client",
    "test:e2e": "npx playwright test --config packages/client/playwright.config.ts",
    "agent-memory:check": "npm --prefix ../agent-memory run check",
    "architecture:check": "node scripts/check-architecture-boundaries.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
